*.secret
*.key
*.pem
*-authorization
secrets/
credential.json
settings.json
tunnel-client.yaml
.env
.env.*

# Logs and local state
*.log
*.ndjson
logs/
state/

# Downloaded binaries and release evidence
tunnel-client
tunnel-client-*/
*.zip
SHA256SUMS.txt
*.sigstore.json

node_modules/
.DS_Store
